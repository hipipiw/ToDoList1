<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Dialog -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Kategori ✨"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvCloseDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="✕"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="2dp"/>
    </RelativeLayout>

    <!-- Baris Input Nama + Preview Icon Bundar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <!-- Tips: Komponen ini sekarang bisa diklik untuk memicu keyboard emoji -->
        <TextView
            android:id="@+id/tvCategoryPreview"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#D87093"
            android:gravity="center"
            android:text="🎯"
            android:textSize="20sp"
            android:tooltipText="Klik untuk emoji kustom"
            android:clickable="true"
            android:focusable="true"/>

        <EditText
            android:id="@+id/etNewCategory"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_filter_capsule"
            android:backgroundTint="#FDF8F9"
            android:hint="Nama kategori..."
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="textCapWords" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💡 Tips: Klik ikon bulat emoji di atas untuk mengetik emoji kustom!"
        android:textColor="@color/pink_primary"
        android:textSize="11sp"
        android:layout_marginTop="6dp"/>

    <!-- PILIH EMOJI -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PILIH EMOJI BAWAAN"
        android:textColor="@color/text_light"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <GridLayout
        android:id="@+id/gridEmojis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:columnCount="6"
        android:alignmentMode="alignBounds"/>

    <!-- PILIH WARNA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PILIH WARNA"
        android:textColor="@color/text_light"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

    <!-- PERBAIKAN: Dibungkus HorizontalScrollView agar warna bisa digeser kanan-kiri -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp">
        <LinearLayout
            android:id="@+id/layoutColorsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>
    </HorizontalScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSimpanKategori"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_bold"
        android:text="Simpan Kategori"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textAllCaps="false"/>
</LinearLayout>