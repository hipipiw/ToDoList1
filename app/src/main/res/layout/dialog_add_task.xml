<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Tugas Baru ✨"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvCloseTaskDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="✕"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="2dp"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/pink_primary"
            android:gravity="center"
            android:text="📝"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/etTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_filter_capsule"
            android:backgroundTint="#FDF8F9"
            android:hint="Judul tugas..."
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="textCapSentences" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DESKRIPSI TUGAS"
        android:textColor="@color/text_light"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/etTaskDesc"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_filter_capsule"
        android:backgroundTint="#FDF8F9"
        android:hint="Deskripsi singkat tugas..."
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:inputType="textCapSentences" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PILIH KATEGORI"
        android:textColor="@color/text_light"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <Spinner
        android:id="@+id/spinnerCategory"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_filter_capsule"
        android:backgroundTint="#FDF8F9"
        android:spinnerMode="dropdown" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BATAS TANGGAL"
        android:textColor="@color/text_light"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvTaskDate"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_filter_capsule"
        android:backgroundTint="#FDF8F9"
        android:gravity="center_vertical"
        android:hint="🗓️ Klik untuk pilih tanggal"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSimpan"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_bold"
        android:text="Simpan Tugas"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textAllCaps="false"/>
</LinearLayout>